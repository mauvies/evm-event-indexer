{
  "name": "evm-event-indexer",
  "version": "1.0.0",
  "description": "Indexes smart contract events from EVM chains into MongoDB and serves them through a REST API",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev:poc": "tsx --env-file .env poc/scan.ts",
    "dev:scanner": "tsx watch --env-file .env src/scanner/scanner.ts",
    "dev:api": "tsx watch --env-file .env src/api/server.ts",
    "build": "tsup",
    "start:scanner": "node --env-file .env dist/scanner/scanner.js",
    "start:api": "node --env-file .env dist/api/server.js",
    "db:start": "docker run -d -p 27017:27017 --rm --name evm-indexer-mongo-dev mongo:latest",
    "db:stop": "docker stop evm-indexer-mongo-dev",
    "compose": "docker compose up",
    "compose:down": "docker compose down",
    "lint": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@typegoose/typegoose": "^13.1.0",
    "cors": "^2.8.6",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "mongoose": "^9.2.3",
    "p-retry": "^7.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.15",
    "@types/supertest": "^7.2.0",
    "husky": "^9.1.7",
    "mongodb-memory-server": "^11.0.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "mongodb-memory-server"
    ]
  }
}
