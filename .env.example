NODE_ENV=development
CHAIN=polygon
MONGO_URI="mongodb://localhost:27017/lifi-fees"
API_PORT=3000
LOG_LEVEL=info

# Polygon RPC endpoint. Includes the provider API key, so it is never committed.
# Any provider works; the scanner was tuned against Ankr's free tier limits.
RPC_URL="https://rpc.ankr.com/polygon/<your-api-key>"
