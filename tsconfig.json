{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2023"]
  },
  // poc/ is kept deliberately as a record of the exploration, so it is
  // type-checked like the rest. It is not a build entry: tsup only emits
  // src/scanner and src/api.
  "include": ["src", "poc"],
  "exclude": ["node_modules", "dist"]
}
